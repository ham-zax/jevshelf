#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
CLI="$ROOT/.venv/bin/jevshelf"
if [[ ! -x "$CLI" ]]; then
  echo 'JevShelf environment missing; run bash scripts/bootstrap.sh' >&2
  exit 127
fi
# Some agent hosts do not inherit login-shell API credentials.
if [[ "${1:-}" == search && -z "${TYPESAFE_API_KEY:-}" && -z "${JEV_API_KEY:-}" ]]; then
  for ((i=1;i<=$#;i++)); do
    if [[ "${!i}" == --mode ]]; then
      j=$((i+1))
      if ((j <= $#)) && [[ "${!j}" == jev ]]; then
        exec bash -lic 'exec "$@"' jevshelf-login "$CLI" "$@"
      fi
    fi
  done
fi
exec "$CLI" "$@"
